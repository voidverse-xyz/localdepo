# syntax=docker/dockerfile:1
# Development image: runs `next dev` with hot reload. Used by docker-compose.yml
# together with Compose watch for live editing.
FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV DATA_DIR=/data

# Install dependencies first so this layer is cached until package.json changes.
COPY package.json package-lock.json* ./
RUN npm install

# Source is copied for the initial run; Compose watch keeps it in sync afterwards.
COPY . .
RUN mkdir -p /data/uploads

EXPOSE 3000
CMD ["npm", "run", "dev"]
