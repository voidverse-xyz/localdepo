# Set a unique admin password to edit services, layout, and background settings.
ADMIN_PASSWORD=

# Set a random signing secret of at least 32 bytes (e.g. openssl rand -hex 32).
SESSION_SECRET=

# Optional: CIDR to scan (e.g. 192.168.1.0/24). If unset, the host subnet is auto-detected.
# SCAN_CIDR=192.168.1.0/24

# Optional: where the JSON config + uploads are stored. Defaults to /data.
# DATA_DIR=/data

# Development host port (container listens on 3000).
# DEV_PORT=3001

# Production port when using host networking.
# PORT=3000
